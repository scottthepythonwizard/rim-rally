NEXT_PUBLIC_API_MODE=server
# Uncomment to enable checkout and staff screens as well as the public schedule.
# NEXT_PUBLIC_BACKEND_ENABLED=1
# Shared guest/staff storage. Use mock only for isolated demo tests.
NEXT_PUBLIC_API_BASE_URL=/api

# Next.js forwards guest requests; staff actions call this private server URL.
# Set NEXT_PUBLIC_BACKEND_ENABLED=0 and rebuild to pause backend-dependent screens.
STAFF_APP_ORIGIN=http://127.0.0.1:3000
DJANGO_API_BASE_URL=http://127.0.0.1:8000/api
